        const pf=path.join(dest,'project.json'),pj=JSON.parse(fs.readFileSync(pf,'utf8'));pj.settings={fps:30,captions:{on:true},...(pj.settings||{})};fs.writeFileSync(pf,JSON.stringify(pj,null,2)+'\n');
