  function maybeCompleteBuild() {
    if (SUBSTEPS.every(s => state.substeps[s] === 'done') && state.steps.build !== 'done') {
      state.steps.build = 'done';
      state.stepTimes.build = state.stepTimes.build || {};
      state.stepTimes.build.end = Date.now();
