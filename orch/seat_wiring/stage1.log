'use strict';
const $ = s => document.querySelector(s), esc = s => String(s ?? '').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const navItems=[['Home','home'],['Berserk','berserk'],['Projects','projects'],['Channels','channels'],['Editor','editor'],['Styles','styles'],['Library','library'],['Memory','memory'],['Routines','routines'],['Renders','renders'],['YouTube','youtube']];
let screen='home',project=null,projects=[],jobId=null,passJobId=null,mode='quality',jobTimer=null,passTimer=null,annotations=[],conversationId=null,conversation=null,chatTab='chat',styleCatalog={defaultStyle:'cartoon-shorts',currentStyle:'cartoon-shorts',styles:[]};
async function api(path,body){const r=await fetch(path,body?{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}:{});let d;try{d=await r.json()}catch(_){d={error:await r.text()}}if(!r.ok)throw Error(d.error||`Request failed (${r.status})`);return d}
function toast(s){const t=$('#toast');t.textContent=s;t.classList.add('show');clearTimeout(toast.t);toast.t=setTimeout(()=>t.classList.remove('show'),3600)}
function heading(title,sub=''){return `<h1>${esc(title)}</h1>${sub?`<p class="sub">${esc(sub)}</p>`:''}`}
function panel(title,content,extra=''){return `<section class="card ${extra}"><h3>${title}</h3>${content}</section>`}
function badge(text,cls=''){return `<span class="badge ${cls}">${esc(text)}</span>`}
function setNav(){const nav=$('#nav');nav.innerHTML=`<div class="nav-label">Workspace</div>`+navItems.map(([n,id],i)=>`${i===4?'<div class="nav-label">Production</div>':''}<button data-screen="${id}" class="${screen===id?'active':''}">${n}</button>`).join('');$('#screenTitle').textContent=navItems.find(x=>x[1]===screen)?.[0]||'New project';$('#railProject').textContent=project?.title||project?.name||'No project';$('#topProject').textContent=project?`${project.title||project.name} · ${project.path||''}`:''}
async function refreshProject(){try{project=await api('/api/project');styleCatalog=await api('/api/styles')}catch(e){toast(e.message)}}
async function boot(){setNav();try{projects=await api('/api/projects');await refreshProject();await refreshSeats();render()}catch(e){$('#view').innerHTML=`${heading('Heart Studio','The local server could not provide project data.')}<div class="warning">${esc(e.message)}</div>`}}
async function refreshSeats(){try{const d=await api('/api/connections');const rows=d.connections||[];$('#seats').innerHTML=['GPT','Gemini','Opus','GLM'].map(n=>{const x=rows.find(c=>c.name===n)||{};return `<div class="seat"><i class="${x.status==='connected'?'connected':''}"></i>${n} <span class="muted">${esc(x.status||'unprobed')}</span></div>`}).join('')}catch(e){toast(e.message)}}
function render(){setNav();const view=$('#view');const pages={home:homePage,berserk:berserkPage,projects:projectsPage,new:newPage,editor:editorPage,renders:rendersPage,styles:stylesPage};if(pages[screen])view.innerHTML=pages[screen]();else view.innerHTML=`${heading(navItems.find(x=>x[1]===screen)?.[0]||screen)}<div class="card"><div class="row">${badge('not wired yet','not-wired')}</div><p class="muted">There is no backend for this section yet.</p></div>`;bindPage();}
function invBadges(p){return `<div class="stats">${badge(p.script?'Script ready':'No script',p.script?'ok':'')}${badge(p.voice?'Voice ready':'No voice',p.voice?'ok':'')}${badge(p.timing?'Timing ready':'No timing',p.timing?'ok':'')}${badge(`${p.boardCount||0} board frames`)}${badge(p.master?'Master ready':'No master',p.master?'ok':'')}</div>`}
function homePage(){const cards=projects.map(p=>`<article class="card"><div class="row between"><h3>${esc(p.title||p.name)}</h3>${badge(p.name===project?.name?'Selected':'Project')}</div>${invBadges(p)}<div class="row" style="margin-top:12px"><button data-select="${esc(p.name)}">Select</button><button data-open-editor="${esc(p.name)}">Open Editor</button></div></article>`).join('');return `${heading('Home','The production floor for projects, seats, and dispatched work.')}<div class="section-head"><h2>Model seats</h2><button id="probeHome">Probe all seats</button></div><div class="grid two">${['GPT','Gemini','Opus','GLM'].map(n=>panel(n,`<p id="homeSeat-${n}" class="muted">Loading connection state…</p>`)).join('')}</div><div class="section-head"><h2>Projects</h2><button data-screen="projects">All projects →</button></div><div class="grid">${cards||'<div class="empty">No projects found.</div>'}</div><div class="section-head"><h2>Recent fleet runs</h2><button data-screen="renders">View renders →</button></div><div id="homeRuns" class="card muted">Loading fleet runs…</div>`}
function legNames(){return ['script','voice','timing','board','sound','gates','export']}
function berserkPage(){return `${heading('Berserk','A single conversation from request through delivery.')}<div class="chat-tabs"><button data-chat-tab="chat" class="${chatTab==='chat'?'selected':''}">Director chat</button><button data-chat-tab="supervision" class="${chatTab==='supervision'?'selected':''}">Run supervision</button><button id="newConversation">＋ New conversation</button><select id="resumeConversation"><option value="">Resume a conversation…</option></select></div>${chatTab==='chat'?directorChatPage():supervisionPage()}`}
function directorChatPage(){
 const msgs=conversation?.messages||[],selectedStyle=conversation?.inputs?.style||project?.settings?.style||styleCatalog.defaultStyle;
 return `${heading('Berserk','A single conversation from request through delivery.')}<div class="chat-tabs"><button data-chat-tab="chat" class="${chatTab==='chat'?'selected':''}">Director chat</button><button data-chat-tab="supervision" class="${chatTab==='supervision'?'selected':''}">Run supervision</button><button id="newConversation">＋ New conversation</button><select id="resumeConversation"><option value="">Resume a conversation…</option></select></div><div class="director-layout"><aside class="conversation-list card"><b>Conversations</b><div id="conversationList" class="conversation-items">Loading…</div></aside><section class="director-chat card"><div class="chat-intro"><span class="eyebrow">DIRECTOR · ${esc(conversation?.project||'NEW CONVERSATION')}</span><h2>${esc(conversation?.title||'What are we making?')}</h2><p>Describe the film, paste the story and priorities, and attach the original narration. The narration is used exactly as provided.</p></div><div class="chat-messages" id="chatMessages">${chatMessagesHtml(msgs)}</div><form id="directorForm" class="director-composer"><textarea name="text" placeholder="Tell me what video you want. Paste the story and what matters most here…" required></textarea><div class="composer-tools composer-control-row"><div class="attach-control"><button type="button" id="pickChatAudio" class="icon-control" aria-label="Attach narration" title="Attach narration"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8.5 12.5 7.1-7.1a4 4 0 0 1 5.7 5.7l-9.9 9.9a6 6 0 0 1-8.5-8.5l9.2-9.2"/></svg><span>Attach</span></button><input id="chatAudio" aria-label="Narration audio path" placeholder="Paste narration path…"></div><label>Model <select id="chatModel"><option value="gpt-6-luna">GPT · Codex seat</option></select></label><label>Effort <select id="chatEffort" disabled><option value="standard">Standard</option><option value="high">High</option></select> ${badge('not wired yet','not-wired')}</label><label class="toggle-control"><input id="exactShotPlan" type="checkbox" checked disabled> Exact shot plan ${badge('not wired yet','not-wired')}</label><label>Style <select id="chatStyle">${styleOptionMarkup(selectedStyle)}</select><span id="chatStyleState">${styleStateMarkup(selectedStyle)}</span></label><label>Build mode <select id="chatMode"><option value="quality">Quality</option><option value="faster">Faster</option></select></label><label>FPS <select id="chatFps"><option value="24">24 fps</option><option value="30" selected>30 fps</option></select></label><button class="btn-primary send-control"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 4 17 8-17 8 3-8-3-8Zm3 8h14"/></svg>Send</button></div><small class="muted">Style changes are saved with this conversation and project. In-program ASR status: <span id="asrStatus">Checking local model…</span> · <span class="not-wired-text">Effort routing, exact shot planning, full render queue, and cost/time reporting not wired yet</span></small></form></section></div>`
}
function supervisionPage(){const legs=legNames().map(x=>`<div class="leg"><b>${x}</b><span id="leg-${x}" class="chip">waiting</span></div>`).join('');return `<section class="hero-console"><div class="row between"><div><span class="eyebrow">RUN CONTROL · ACTIVE PROJECT</span><h2 style="margin-top:5px">${esc(project?.title||project?.name||'No project selected')}</h2></div><span id="runStatus" class="chip">idle</span></div><div class="run-controls"><div class="field"><label>Build mode</label><div class="segmented"><button data-mode="quality" class="${mode==='quality'?'selected':''}">Quality</button><button data-mode="faster" class="${mode==='faster'?'selected':''}">Faster</button></div></div><div class="field"><label for="runModel">Model</label><select id="runModel"><option value="free/glm-5.3-flashx">GLM 5.3 FlashX</option><option value="free/gpt-6-luna">GPT 6 Luna</option></select></div><div class="field"><label for="runEffort">Effort</label><select id="runEffort"><option>standard</option><option>high</option></select></div><div class="field"><label for="runSpec">Render spec</label><input id="runSpec" value="render:0:30"></div><label class="field"><span>Stills</span><span><input id="dispatchStills" type="checkbox"> Dispatch for board</span></label><button id="runBtn" class="btn-primary">▶ RUN</button></div></section><div class="waiting" id="waitingLine">Waiting on you: nothing</div><div id="timingAsrStatus" class="muted"></div><div class="section-head"><h2>Run legs</h2><span class="muted">Artifact predicates control completion</span></div><div class="legs">${legs}</div><div class="section-head"><h2>Live supervision feed</h2><button id="stopBtn" class="btn-danger" disabled>■ Stop</button></div><div class="feed" id="runFeed">Run events appear here when a job starts.</div><div class="section-head"><h2>Board frames · click to annotate</h2></div><div class="frames">${(project?.board||[]).map(f=>`<button class="frame" data-frame="${esc(f)}"><img src="/project/out/board/${encodeURIComponent(f)}"><span>${esc(f)}</span></button>`).join('')||'<div class="empty">No board stills found for this project.</div>'}</div><div class="section-head"><h2>Prop-truth gates · crops</h2></div><div id="propGateStatus" class="prop-gate-list"></div><div class="section-head"><h2>Frame annotations</h2></div><div id="annotations" class="annotation-list"></div><div class="section-head"><h2>Steer the run</h2></div><div class="inline-form"><input id="steerText" placeholder="Tell the program what to change while it works" ${jobId?'':'disabled'}><button id="steerBtn" ${jobId?'':'disabled'}>Send</button></div>${jobId?'':'<small class="muted">Steering is live during a run.</small>'}<div class="section-head"><h2>Dispatch</h2></div><div class="grid two"><section class="card"><h3>Storyboard stills</h3><p class="muted">Uses effective project settings.</p><div class="inline-form"><input id="stillsSpec" value="render:0:30"><button id="stillsBtn">Dispatch stills</button></div><p id="stillsStatus" class="muted"></p></section><section class="card"><h3>Assembly</h3><div class="field"><label>Frames run id</label><input id="framesRun" placeholder="GitHub Actions run id"></div><div class="row"><label>FPS <select id="assemblyFps"><option>24</option><option selected>30</option></select></label><label>Mix path <input id="mixPath" value="audio/final_mix.wav"></label><button id="assemblyBtn">Dispatch assembly</button></div><p id="assemblyStatus" class="muted"></p></section></div><div class="section-head"><h2>Film render queue</h2>${badge('not dispatchable from inside the program yet','not-wired')}</div><div id="colab" class="card muted">Loading queue…</div>`}
function projectsPage(){return `${heading('Projects','Choose the project controlled by the production console.')}<div class="grid">${projects.map(p=>`<article class="card"><h3>${esc(p.title||p.name)}</h3><p class="muted">${esc(p.name)}</p>${invBadges(p)}<div class="row" style="margin-top:14px"><button data-select="${esc(p.name)}">Select</button><button data-open-editor="${esc(p.name)}">Open in Editor</button></div></article>`).join('')}</div>`}
function newPage(){return `${heading('New project','Start with a brief and attach the original narration file.')}<div class="grid two"><form class="card" id="newForm"><h3>Project brief</h3><div class="field"><label>Name</label><input name="name" pattern="[a-zA-Z0-9_-]+" required placeholder="my-short-film"></div><div class="field"><label>Idea / direction</label><textarea name="idea" required placeholder="Describe the film and what the program should build."></textarea></div><div class="field"><label>Voice file (used exactly as provided)</label><div class="inline-form"><input name="audioPath" required placeholder="Absolute audio file path"><button type="button" data-pick="audio" data-target="audioPath">Pick</button></div></div><div class="field"><label>Timings file (optional)</label><div class="inline-form"><input name="timingsPath" placeholder="Optional absolute path"><button type="button" data-pick="text" data-target="timingsPath">Pick</button></div></div><div class="field"><label>Template</label><select name="template">${projects.map(p=>`<option value="${esc(p.name)}" ${p.name==='demo-ring'?'selected':''}>${esc(p.name)}</option>`).join('')}</select></div><button class="btn-primary">Create project</button></form><section class="card"><h3>Creation result</h3><div id="newResult" class="muted">The created project and push result will appear here.</div></section></div>`}
function editorPage(){return `${heading('Editor',`Project anatomy and measured evidence · ${project?.title||project?.name||''}`)}<div class="section-head"><h2>Stations</h2><button id="refreshEditor">Refresh evidence</button></div><div class="grid">${[['Script & voice',project?.script,project?.voice],['Timing',project?.timing],['Board',project?.boardCount?`${project.boardCount} frames`:null],['QC gates',project?.gates?.pass?'All measured checks pass':'Checks need attention'],['Render',project?.runInfo?.filmGradedInFrames?'Frame grade recorded':null],['Finish',project?.runInfo?.filmGrade||null],['Master',project?.master]].map(([t,...e])=>panel(t,`<p>${e.filter(Boolean).map(esc).join('<br>')||'<span class="muted">No matching artifact on disk.</span>'}</p>`)).join('')}</div><div class="section-head"><h2>Programmatic QC gates</h2></div><div class="card" id="qc"></div><div class="section-head"><h2>Project settings</h2></div><form class="card" id="settingsForm"><div class="row"><label><input type="checkbox" name="captions" ${project?.settings?.captions?.on?'checked':''}> Captions</label><label>Frame rate <select name="fps"><option value="24" ${project?.settings?.fps===24?'selected':''}>24 fps</option><option value="30" ${project?.settings?.fps!==24?'selected':''}>30 fps</option></select></label><button>Save settings</button><span id="settingsNote" class="muted"></span></div></form><div class="section-head"><h2>History</h2></div><div id="history" class="card muted">Loading project history…</div><div class="section-head"><h2>Board stills</h2></div><div class="frames">${(project?.board||[]).map(f=>`<button class="frame" data-frame="${esc(f)}"><img src="/project/out/board/${encodeURIComponent(f)}"><span>${esc(f)}</span></button>`).join('')||'<div class="empty">No board stills found.</div>'}</div><div class="section-head"><h2>Slice narration</h2></div><div class="card"><div class="inline-form"><input id="sliceSeconds" type="number" min="0.1" max="600" value="30"><button id="sliceBtn">Create slice</button></div><div id="sliceResult" class="muted"></div></div><div class="section-head"><h2>Sound mix</h2></div><div class="card"><button id="mixBtn">Mix now</button><span id="mixResult" class="muted"></span></div><div class="section-head"><h2>Pass checkpoints</h2><span class="muted">Build → Camera angles → Environment overhaul → Post-processing → Shading</span></div><div id="passes" class="pass-list"></div><div class="section-head"><h2>Pass feed</h2></div><div id="passFeed" class="feed">Select Run on an available pass to see its feed.</div><div class="section-head"><h2>Frame annotations</h2></div><div id="annotations" class="annotation-list"></div>`}
function rendersPage(){return `${heading('Renders','GitHub Actions fleet runs reported by the dispatch layer.')}<div class="card" id="renderTable">Loading fleet runs…</div>`}
function styleOptionMarkup(selected){return (styleCatalog.styles||[]).map(s=>`<option value="${esc(s.id)}" ${s.id===selected?'selected':''} ${s.wired?'':'disabled'}>${esc(s.label)}${s.wired?'':' — NOT WIRED'}</option>`).join('')}
function styleStateMarkup(id){const s=(styleCatalog.styles||[]).find(x=>x.id===id);return s?`${badge(s.wired?'WIRED':'NOT WIRED',s.wired?'ok':'not-wired')} <small class="muted">${esc(s.reason)}</small>`:badge('style not in registry','not-wired')}
function stylesPage(){const current=project?.settings?.style||styleCatalog.defaultStyle;return `${heading('Styles','Production styles are loaded from the packs Heart Studio actually holds.')}<section class="card"><div class="row between"><div><span class="eyebrow">ACTIVE PROJECT STYLE</span><h2>${esc(project?.title||project?.name||'No project selected')}</h2><p id="activeStyleReason">${styleStateMarkup(current)}</p></div><div class="row"><label for="projectStyle">Style</label><select id="projectStyle">${styleOptionMarkup(current)}</select><button id="saveProjectStyle" class="btn-primary" ${project?.name?'':'disabled'}>Save style</button></div></div><small id="styleSaveNote" class="muted">This writes project.json settings.style; chat and pass runs read the same setting.</small></section><div class="section-head"><h2>Available packs</h2></div><div class="card"><div class="table-wrap"><table class="table"><thead><tr><th>Pack</th><th>Status</th><th>Reason</th></tr></thead><tbody>${(styleCatalog.styles||[]).map(s=>`<tr><td>${esc(s.label)}<br><small class="muted">${esc(s.id)}</small></td><td>${badge(s.wired?'WIRED':'NOT WIRED',s.wired?'ok':'not-wired')}</td><td>${esc(s.reason)}</td></tr>`).join('')}</tbody></table></div></div>`}

let pageToken=0,activePolls=new Set(),annotationFrame='';
function chatMessagesHtml(rows=[]){return rows.map(m=>`<article class="chat-message ${m.role==='user'?'user-message':''}"><small>${esc(m.role==='user'?'You':'Director')} · ${esc(m.kind||'message')}</small><div>${esc(m.text)}</div>${m.kind==='board'?(m.frames||[]).map(f=>`<a href="/project/out/board/${encodeURIComponent(f)}"><img class="chat-frame" src="/project/out/board/${encodeURIComponent(f)}"></a>`).join(''):''}</article>`).join('')||'<div class="empty">Your request, story, and priorities belong in the message below.</div>'}
async function openConversation(id){try{conversationId=id;conversation=await api(`/api/conversations/${id}`);if(conversation.project){try{await api('/api/select',{name:conversation.project});await refreshProject()}catch(_){}}render()}catch(e){errToast(e)}}
async function pollConversation(id,token){if(token!==pageToken||screen!=='berserk'||chatTab!=='chat'||id!==conversationId)return;try{conversation=await api(`/api/conversations/${id}`);const host=$('#chatMessages');if(host){host.innerHTML=chatMessagesHtml(conversation.messages);host.scrollTop=host.scrollHeight;}if(conversation.board?.length){const hostFrames=$('#conversationBoard');if(hostFrames)hostFrames.innerHTML=conversation.board.map(f=>`<a href="/project/out/board/${encodeURIComponent(f)}"><img class="chat-frame" src="/project/out/board/${encodeURIComponent(f)}"></a>`).join('');}}catch(_){}const timer=setTimeout(()=>{activePolls.delete(timer);pollConversation(id,token)},2200);activePolls.add(timer)}
const listen=(el,event,fn)=>el&&el.addEventListener(event,fn);
const errToast=e=>toast(e?.message||String(e));
function feedLines(target,lines){if(!target)return;target.innerHTML=(lines||[]).map(x=>`<div class="feed-line"><span class="muted">${esc(x.stream||'log')}</span> ${esc(x.text||'')}</div>`).join('')||'<span class="muted">No log output yet.</span>';target.scrollTop=target.scrollHeight}
function stopPolls(){for(const p of activePolls)clearTimeout(p);activePolls.clear()}
async function pollJob(id,{onLog=()=>{},onUpdate=()=>{},onDone=()=>{},statusTarget=null}={}){const token=pageToken;let seen=0;while(token===pageToken){try{const job=await api(`/api/job?id=${encodeURIComponent(id)}`);const lines=job.log||[];if(lines.length>seen){onLog(lines.slice(seen),lines);seen=lines.length}if(statusTarget)statusTarget.textContent=job.status||'running';onUpdate(job);if(job.ended||['done','failed','blocked','cancelled'].includes(job.status)){onDone(job);return job}}catch(e){if(token===pageToken)toast(e.message);return null}await new Promise(resolve=>{const timer=setTimeout(()=>{activePolls.delete(timer);resolve()},1500);activePolls.add(timer)})}return null}
function renderAnnotations(rows=annotations){const host=$('#annotations');if(!host)return;host.innerHTML=rows.length?rows.map(a=>{const status=a.status==='captured_unwired'?'open':a.status||'open';return `<div class="annotation"><b>${esc(a.frame)}</b> · ${esc(a.change)} ${badge(status==='addressed'?`addressed · ${a.addressedBy||'pass'}`:status,status==='addressed'?'ok':'')} ${a.checkpointCommit?`<small>Checkpoint ${esc(a.checkpointCommit.slice(0,12))}</small>`:''}</div>`}).join(''):'<div class="empty">No frame annotations yet.</div>'}
function propGateMarkup(p){const g=p?.propGate;if(!g)return '<div class="muted">Prop-truth gate has not run for this pass.</div>';const imgs=(g.crops||[]).map(c=>{const f=String(c.crop||'').split('/').pop();return `<figure><img src="/project/out/passes/${encodeURIComponent(p.id)}/${encodeURIComponent(f)}"><figcaption>${esc(c.name)} → ${esc(c.seen||'not reviewed')}</figcaption></figure>`}).join('');return `<div class="prop-gate-box"><b>Prop-truth gate · ${esc(g.status)}</b>${(g.failures||[]).map(x=>`<div class="warning">${esc(x)}</div>`).join('')}<div class="prop-crops">${imgs||'<small class="muted">No zoom crops recorded.</small>'}</div></div>`}
async function loadGateSummary(){const host=$('#propGateStatus');if(!host)return;try{const rows=await api('/api/passes');host.innerHTML=rows.map(p=>`<section class="card"><b>${esc(p.label)}</b> ${badge(p.propGate?.status||'not run',p.propGate?.ok?'ok':'warn')}${propGateMarkup(p)}</section>`).join('')}catch(e){host.innerHTML=`<div class="warning">${esc(e.message)}</div>`}}
async function loadAsrStatus(){try{const s=await api('/api/asr-status');const label=s.available?`connected · ${s.engine} (${s.model||'small'})`:'not wired yet · '+(s.error||'local ASR engine unavailable');const a=$('#asrStatus'),b=$('#timingAsrStatus');if(a){a.textContent=label;a.className=s.available?'success':'not-wired-text'}if(b){b.textContent=`Timing leg ASR: ${label}`;b.className=s.available?'success':'not-wired-text'}}catch(e){const a=$('#asrStatus'),b=$('#timingAsrStatus');if(a){a.textContent='not wired yet · status unavailable';a.className='not-wired-text'}if(b){b.textContent='Timing leg ASR: not wired yet · status unavailable';b.className='not-wired-text'}}}
async function loadAnnotations(){try{annotations=await api('/api/annotations');renderAnnotations()}catch(e){errToast(e)}}
function openAnnotation(frame){annotationFrame=frame;let form=$('#annotationForm');if(!form){form=document.createElement('form');form.id='annotationForm';form.className='card';form.innerHTML='<h3>Frame change</h3><div class="inline-form"><input name="frame" aria-label="Frame" readonly><input name="change" placeholder="Describe the change" required><button>Save annotation</button><button type="button" data-annotation-cancel>Cancel</button></div>';const host=$('#annotations');(host?.parentElement||$('#view')).insertBefore(form,host||null);listen(form,'submit',async e=>{e.preventDefault();const data=new FormData(form);try{const a=await api('/api/annotations',{frame:data.get('frame'),change:data.get('change')});annotations.push(a);renderAnnotations();form.remove();toast(a.note||`Annotation saved (${a.status})`)}catch(err){errToast(err)}});listen(form.querySelector('[data-annotation-cancel]'),'click',()=>form.remove())}form.elements.frame.value=frame;form.elements.change.focus()}
async function loadRuns(target,limit){try{const rows=await api('/api/dispatch/runs');const list=(rows||[]).slice(0,limit||rows.length);target.innerHTML=list.length?`<div class="table-wrap"><table><thead><tr><th>Workflow</th><th>Status</th><th>Conclusion</th><th>Created</th><th>Run</th></tr></thead><tbody>${list.map(r=>`<tr><td>${esc(r.workflowName)}</td><td>${esc(r.status)}</td><td>${esc(r.conclusion||'—')}</td><td>${esc(r.createdAt||'')}</td><td>${esc(r.databaseId)}</td></tr>`).join('')}</tbody></table></div>`:'<div class="empty">No fleet runs found.</div>'}catch(e){target.innerHTML=`<div class="warning">${esc(e.message)}</div>`;toast(e.message)}}
async function loadPasses(){const host=$('#passes');if(!host)return;try{const rows=await api('/api/passes');host.innerHTML=(rows||[]).map((p,i)=>{const ready=i===0||(rows.slice(0,i).every(x=>x.state==='checkpointed'));return `<div class="pass-row"><div><b>${esc(p.label||p.id)}</b> ${badge(p.state||'not_started')}</div><span class="muted">${Number(p.rounds)||0} rounds</span><div class="row"><button data-pass="${esc(p.id)}" ${ready?'':'disabled'}>Run</button><button data-rollback="${esc(p.id)}">Rollback</button></div>${propGateMarkup(p)}</div>`}).join('')||'<div class="empty">No passes configured.</div>';bindPassButtons()}catch(e){host.innerHTML=`<div class="warning">${esc(e.message)}</div>`;toast(e.message)}}
function bindPassButtons(){document.querySelectorAll('[data-pass]').forEach(b=>listen(b,'click',async()=>{try{const d=await api('/api/passes/run',{pass:b.dataset.pass,mode});passJobId=d.id;feedLines($('#passFeed'),[]);await pollJob(d.id,{onLog:(fresh,all)=>feedLines($('#passFeed'),all),onDone:async j=>{toast(`Pass ${b.dataset.pass}: ${j.status}`);await loadPasses()}})}catch(e){errToast(e)}}));document.querySelectorAll('[data-rollback]').forEach(b=>listen(b,'click',async()=>{try{await api('/api/passes/rollback',{pass:b.dataset.rollback});toast(`Rolled back ${b.dataset.rollback}`);await loadPasses()}catch(e){errToast(e)}}))}
function bindPage(){stopPolls();const token=++pageToken;document.querySelectorAll('[data-screen]').forEach(b=>listen(b,'click',()=>{screen=b.dataset.screen;render()}));document.querySelectorAll('[data-new-project]').forEach(b=>listen(b,'click',()=>{screen='new';render()}));document.querySelectorAll('[data-open-editor]').forEach(b=>listen(b,'click',async()=>{try{await api('/api/select',{name:b.dataset.openEditor});await refreshProject();screen='editor';render()}catch(e){errToast(e)}}));document.querySelectorAll('[data-select]').forEach(b=>listen(b,'click',async()=>{try{await api('/api/select',{name:b.dataset.select});await refreshProject();if(b.dataset.goto==='editor'||b.hasAttribute('data-open-editor'))screen='editor';render()}catch(e){errToast(e)}}));const probe=async()=>{try{await api('/api/connections/probe',{});await refreshSeats();toast('Connection probe complete')}catch(e){errToast(e)}};listen($('#probe'),'click',probe);listen($('#probeHome'),'click',probe);
if(screen==='berserk'){document.querySelectorAll('[data-chat-tab]').forEach(b=>listen(b,'click',()=>{chatTab=b.dataset.chatTab;render()}));listen($('#newConversation'),'click',()=>{conversationId=null;conversation=null;chatTab='chat';render()});listen($('#resumeConversation'),'change',e=>e.target.value&&openConversation(e.target.value));}
if(screen==='styles'){listen($('#saveProjectStyle'),'click',async()=>{try{const d=await api('/api/settings',{style:$('#projectStyle').value});await refreshProject();$('#activeStyleReason').innerHTML=styleStateMarkup(d.settings.style);$('#styleSaveNote').textContent=`Saved ${d.settings.style} to project.json`;toast('Project style saved')}catch(e){errToast(e)}})}
if(screen==='berserk'&&chatTab==='chat'){listen($('#chatStyle'),'change',e=>{const host=$('#chatStyleState');if(host)host.innerHTML=styleStateMarkup(e.target.value)});const refreshThreads=async()=>{try{const rows=await api('/api/conversations');const list=$('#conversationList'),select=$('#resumeConversation');if(list)list.innerHTML=rows.map(x=>`<button data-resume-chat="${esc(x.id)}" class="${x.id===conversationId?'selected':''}">${esc(x.title||x.id)}<small>${esc(x.project||'not set up')}</small></button>`).join('')||'<small class="muted">No saved conversations.</small>';if(select)select.innerHTML='<option value="">Resume a conversation…</option>'+rows.map(x=>`<option value="${esc(x.id)}" ${x.id===conversationId?'selected':''}>${esc(x.title||x.id)}</option>`).join('');document.querySelectorAll('[data-resume-chat]').forEach(b=>listen(b,'click',()=>openConversation(b.dataset.resumeChat)));}catch(e){errToast(e)}};refreshThreads();listen($('#pickChatAudio'),'click',async()=>{try{const v=await window.heartApp?.pickFile?.('audio');const p=typeof v==='string'?v:v?.path;if(p)$('#chatAudio').value=p;else if(!window.heartApp?.pickFile)$('#chatAudio').focus()}catch(e){errToast(e)}});listen($('#directorForm'),'submit',async e=>{e.preventDefault();const text=new FormData(e.currentTarget).get('text').trim();try{if(!conversationId){const audioPath=$('#chatAudio').value.trim();const name='film-'+new Date().toISOString().replace(/\D/g,'').slice(0,14);conversation=await api('/api/conversations',{title:text.slice(0,48)||'New conversation',name,audioPath,story:text,priorities:text,model:$('#chatModel').value,effort:$('#chatEffort').value,exactShotPlan:false,mode:$('#chatMode').value,fps:Number($('#chatFps').value),style:$('#chatStyle').value});conversationId=conversation.id;}const audioPath=$('#chatAudio').value.trim();conversation.messages=conversation.messages||[];conversation.messages.push({role:'user',text,kind:'message'},{role:'assistant',text:'I’m checking the request and availab