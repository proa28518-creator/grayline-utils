 function editorPage(){return `${heading('Editor',`Project anatomy and measured evidence · ${project?.title||project?.name||''}`)}<div class="section-head"><h2>Stations</h2><button id="refreshEditor">Refresh evidence</button></div><div class="grid">${[['Script & voice',project?.script,project?.voice],['Timing',project?.timing],['Board',project?.boardCount?`${project.boardCount} frames`:null],['QC gates',project?.gates?.pass?'All measured checks pass':'Checks need attention'],['Render',project?.runInfo?.filmGradedInFrames?'Frame grade recorded':null],['Finish',project?.runInfo?.filmGrade||null],['Master',project?.master]].map(([t,...e])=>panel(t,`<p>${e.filter(Boolean).map(esc).join('<br>')||'<span class="muted">No matching artifact on disk.</span>'}</p>`)).join('')}</div><div class="section-head"><h2>Programmatic QC gates</h2></div><div class="card" id="qc"></div><div class="section-head"><h2>Project settings</h2></div><form class="card" id="settingsForm"><div class="row"><label><input type="checkbox" name="captions" ${project?.settings?.captions?.on?'checked':''}> Captions</label><label>Frame rate <select name="fps"><option value="24" ${project?.settings?.fps===24?'selected':''}>24 fps</option><option value="30" ${project?.settings?.fps!==24?'selected':''}>30 fps</option></select></label><button>Save settings</button><span id="settingsNote" class="muted"></span></div></form><div class="section-head"><h2>History</h2></div><div id="history" class="card muted">Loading project history…</div><div class="section-head"><h2>Board stills</h2></div><div class="frames">${(project?.board||[]).map(f=>`<button class="frame" data-frame="${esc(f)}"><img src="/project/out/board/${encodeURIComponent(f)}"><span>${esc(f)}</span></button>`).join('')||'<div class="empty">No board stills found.</div>'}</div><div class="section-head"><h2>Slice narration</h2></div><div class="card"><div class="inline-form"><input id="sliceSeconds" type="number" min="0.1" max="600" value="30"><button id="sliceBtn">Create slice</button></div><div id="sliceResult" class="muted"></div></div><div class="section-head"><h2>Sound mix</h2></div><div class="card"><button id="mixBtn">Mix now</button><span id="mixResult" class="muted"></span></div><div class="section-head"><h2>Pass checkpoints</h2><span class="muted">Build → Camera angles → Environment overhaul → Post-processing → Shading</span></div><div id="passes" class="pass-list"></div><div class="section-head"><h2>Pass feed</h2></div><div id="passFeed" class="feed">Select Run on an available pass to see its feed.</div><div class="section-head"><h2>Frame annotations</h2></div><div id="annotations" class="annotation-list"></div>`}
