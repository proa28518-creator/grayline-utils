16:function homePage(){const cards=projects.map(p=>`<article class="card"><div class="row between"><h3>${esc(p.title||p.name)}</h3>${badge(p.name===project?.name?'Selected':'Project')}</div>${invBadges(p)}<div class="row" style="margin-top:12px"><button data-select="${esc(p.name)}">Select</button><button data-open-editor="${esc(p.name)}">Open Editor</button></div></article>`).join('');return `${heading('Home','The production floor for projects, seats, and dispatched work.')}<div class="section-head"><h2>Model seats</h2><button id="probeHome">Probe all seats</button></div><div class="grid two">${['GPT','Gemini','Opus','GLM'].map(n=>panel(n,`<p id="homeSeat-${n}" class="muted">Loading connection state…</p>`)).join('')}</div><div class="section-head"><h2>Projects</h2><button data-screen="projects">All projects →</button></div><div class="grid">${cards||'<div class="empty">No projects found.</div>'}</div><div class="section-head"><h2>Recent fleet runs</h2><button data-screen="renders">View renders →</button></div><div id="homeRuns" class="card muted">Loading fleet runs…</div>`}
23:function supervisionPage(){const legs=legNames().map(x=>`<div class="leg"><b>${x}</b><span id="leg-${x}" class="chip">waiting</span></div>`).join('');return `<section class="hero-console"><div class="row between"><div><span class="eyebrow">RUN CONTROL · ACTIVE PROJECT</span><h2 style="margin-top:5px">${esc(project?.title||project?.name||'No project selected')}</h2></div><span id="runStatus" class="chip">idle</span></div><div class="run-controls"><div class="field"><label>Build mode</label><div class="segmented"><button data-mode="quality" class="${mode==='quality'?'selected':''}">Quality</button><button data-mode="faster" class="${mode==='faster'?'selected':''}">Faster</button></div></div><div class="field"><label for="runModel">Model</label><select id="runModel"><option value="free/glm-5.3-flashx">GLM 5.3 FlashX</option><option value="free/gpt-6-luna">GPT 6 Luna</option></select></div><div class="field"><label for="runEffort">Effort</label><select id="runEffort"><option>standard</option><option>high</option></select></div><div class="field"><label for="runSpec">Render spec</label><input id="runSpec" value="render:0:30"></div><label class="field"><span>Stills</span><span><input id="dispatchStills" type="checkbox"> Dispatch for board</span></label><button id="runBtn" class="btn-primary">▶ RUN</button></div></section><div class="waiting" id="waitingLine">Waiting on you: nothing</div><div id="timingAsrStatus" class="muted"></div><div class="section-head"><h2>Run legs</h2><span class="muted">Artifact predicates control completion</span></div><div class="legs">${legs}</div><div class="section-head"><h2>Live supervision feed</h2><button id="stopBtn" class="btn-danger" disabled>■ Stop</button></div><div class="feed" id="runFeed">Run events appear here when a job starts.</div><div class="section-head"><h2>Board frames · click to annotate</h2></div><div class="frames">${(project?.board||[]).map(f=>`<button class="frame" data-frame="${esc(f)}"><img src="/project/out/board/